<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/TextAppearance.DopamineCut.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_soft"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="목표 세부 설정"
            android:textColor="@color/ui_primary"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.DopamineCut.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="어떤 사용을\n줄여볼까요?" />

        <TextView
            style="@style/TextAppearance.DopamineCut.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="여러 목표를 함께 선택할 수 있어요."
            android:textColor="@color/ui_text_secondary" />

        <LinearLayout
            android:id="@+id/card_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_modern_card"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/metric_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard"
                android:minHeight="48dp"
                android:text="숏폼 시청 시간"
                android:textColor="@color/ui_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="숏폼을 보는 시간을 줄여요."
                android:textColor="@color/ui_text_secondary" />

            <TextView
                android:id="@+id/summary_time"
                style="@style/TextAppearance.DopamineCut.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/ui_primary"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/averages_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_time"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="세부 설정 ›"
                    android:textColor="@color/ui_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_modern_card"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/metric_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard"
                android:minHeight="48dp"
                android:text="숏폼 시청 영상 수"
                android:textColor="@color/ui_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="넘겨 보는 영상 수를 줄여요."
                android:textColor="@color/ui_text_secondary" />

            <TextView
                android:id="@+id/summary_count"
                style="@style/TextAppearance.DopamineCut.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/ui_primary"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/averages_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_count"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="세부 설정 ›"
                    android:textColor="@color/ui_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_app_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_modern_card"
            android:orientation="vertical"
            android:padding="16dp">

            <CheckBox
                android:id="@+id/metric_app_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard"
                android:minHeight="48dp"
                android:text="앱 사용 시간"
                android:textColor="@color/ui_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="선택한 앱의 전체 사용을 줄여요."
                android:textColor="@color/ui_text_secondary" />

            <TextView
                android:id="@+id/summary_app_time"
                style="@style/TextAppearance.DopamineCut.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="8dp"
                android:textColor="@color/ui_primary"
                android:textSize="22sp" />

            <LinearLayout
                android:id="@+id/averages_app_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/detail_app_time"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="세부 설정 ›"
                    android:textColor="@color/ui_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.DopamineCut.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="숏폼 시간과 앱 시간의 감소량은 합산하지 않아요."
            android:textColor="@color/ui_text_secondary" />

        <LinearLayout
            android:id="@+id/detail_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_modern_card"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/detail_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_time"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="숏폼 시간"
                    android:textSize="12sp"
                    app:strokeColor="@color/ui_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_count"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="영상 수"
                    android:textSize="12sp"
                    app:strokeColor="@color/ui_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab_app_time"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:text="앱 시간"
                    android:textSize="12sp"
                    app:strokeColor="@color/ui_outline" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tv_editing_card"
                style="@style/TextAppearance.DopamineCut.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/target_apps" />

            <CheckBox
                android:id="@+id/cb_youtube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard"
                android:minHeight="48dp"
                android:text="@string/platform_youtube_shorts"
                android:textColor="@color/ui_text_primary" />

            <CheckBox
                android:id="@+id/cb_instagram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard"
                android:minHeight="48dp"
                android:text="@string/platform_instagram_reels"
                android:textColor="@color/ui_text_primary" />

            <CheckBox
                android:id="@+id/cb_kakaotalk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard"
                android:minHeight="48dp"
                android:text="@string/platform_kakaotalk"
                android:textColor="@color/ui_text_primary" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="한도 배분" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="선택한 앱 합계로 관리\n선택 앱의 사용량을 합쳐 한도와 비교해요."
                android:textColor="@color/ui_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/target_time"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/goal_target_watch_time"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/ui_primary"
                app:hintTextColor="@color/ui_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textColor="@color/ui_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/target_count"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/goal_target_video_count"
                android:visibility="gone"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/ui_primary"
                app:hintTextColor="@color/ui_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/ui_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/target_app_time"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/goal_target_app_time"
                android:visibility="gone"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/ui_primary"
                app:hintTextColor="@color/ui_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_app_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard"
                    android:inputType="number"
                    android:maxLength="4"
                    android:textColor="@color/ui_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/goal_card_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/goal_intervention_label" />

            <Spinner
                android:id="@+id/spinner_intervention"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_modern_card"
                android:entries="@array/goal_intervention_options"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tv_intervention_description"
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/goal_intervention_record_description"
                android:textColor="@color/ui_text_secondary" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/goal_intervention_notification_notice"
                android:textColor="@color/ui_text_secondary" />

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/goal_intervention_not_connected"
                android:textColor="@color/ui_text_secondary" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="연속 숏폼 시청 휴식 안내 (분, 0은 끄기)"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/ui_primary"
                app:hintTextColor="@color/ui_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_continuous_break"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/ui_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="숏폼 시간 목표에만 적용합니다. 기록만 보기에서는 안내하지 않으며, 목표 진행 알림을 허용해야 합니다."
                android:textColor="@color/ui_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_validation"
            style="@style/TextAppearance.DopamineCut.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ui_error" />

        <TextView
            android:id="@+id/tv_unavailable"
            style="@style/TextAppearance.DopamineCut.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ui_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:fontFamily="@font/pretendard"
            android:text="@string/managed_goal_save"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/ui_primary"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cancel"
            android:textColor="@color/ui_text_secondary" />

    </LinearLayout>
</ScrollView>