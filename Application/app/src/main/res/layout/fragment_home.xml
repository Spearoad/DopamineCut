<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tab_title"
            style="@style/TextAppearance.DopamineCut.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name" />

        <LinearLayout
            android:id="@+id/layout_measurement_banner"
            style="@style/Widget.DopamineCut.HomeCompactCard"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- 파스텔톤 알약 배지 텍스트 뷰 -->
            <TextView
                android:id="@+id/tv_measurement_status"
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/ui_warning"
                android:textStyle="bold"
                android:accessibilityLiveRegion="polite" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_measurement_settings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/check_settings"
                android:textColor="@color/ui_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/empty_group"
            style="@style/Widget.DopamineCut.HomeCompactCard"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_message"
                style="@style/TextAppearance.DopamineCut.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                style="@style/Widget.DopamineCut.HomeCompactPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다시 불러오기"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/summary_card"
            style="@style/Widget.DopamineCut.HomeCompactCard"
            android:background="@drawable/bg_hero_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone">

            <TextView
                style="@style/TextAppearance.DopamineCut.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘 숏폼 시청 시간"
                android:textColor="@color/ui_text_secondary" />

            <!-- 시청 시간 큰 수치 -->
            <TextView
                android:id="@+id/tv_shortform_time"
                style="@style/TextAppearance.DopamineCut.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ui_primary"
                android:textSize="32sp" />

            <!-- [수정] 1dp 실선 제거 후 marginTop을 16dp로 부여해 깔끔한 여백 형성 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        style="@style/TextAppearance.DopamineCut.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="숏폼 시청 영상 수"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/tv_shortform_count"
                        style="@style/TextAppearance.DopamineCut.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.DopamineCut.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="앱 사용 시간"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/tv_app_time"
                        style="@style/TextAppearance.DopamineCut.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ui_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="앱 사용 시간에는 숏폼 시청 시간이 포함돼요."
                android:textColor="@color/ui_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_goal_title"
                style="@style/TextAppearance.DopamineCut.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="오늘 목표 진행" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_goal_management"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="목표 관리 ›"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/goal_progress_list"
            style="@style/Widget.DopamineCut.HomeCompactCard"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/goal_preparation_card"
            style="@style/Widget.DopamineCut.HomeCompactCard"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_goal_preparation"
                style="@style/TextAppearance.DopamineCut.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_goal_summary"
                style="@style/TextAppearance.DopamineCut.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ProgressBar
                android:id="@+id/preparation_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:max="3"
                android:progressDrawable="@drawable/bg_custom_progress"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_goal"
                style="@style/Widget.DopamineCut.HomeCompactPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="목표 설정하기" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.DopamineCut.Headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="플랫폼별 숏폼" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/metric_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:checkedButton="@id/btn_metric_time"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_metric_time"
                        style="@style/Widget.DopamineCut.HomeCompactOutline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="@string/metric_time"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_metric_count"
                        style="@style/Widget.DopamineCut.HomeCompactOutline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:text="@string/metric_count"
                        android:textSize="12sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>
            </LinearLayout>

            <LinearLayout style="@style/Widget.DopamineCut.HomeCompactCard">

                <TextView
                    android:id="@+id/tv_platform_usage_title"
                    style="@style/TextAppearance.DopamineCut.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/platform_usage_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/layout_platform_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:alpha="0.3"
                        android:src="@android:drawable/ic_menu_info_details" />

                    <TextView
                        android:id="@+id/tv_platform_empty"
                        style="@style/TextAppearance.DopamineCut.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.DopamineCut.Headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="오늘 주로 본 콘텐츠" />

                <TextView
                    android:id="@+id/tv_category_usage_title"
                    style="@style/TextAppearance.DopamineCut.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.DopamineCut.HomeCompactCard">

                <LinearLayout
                    android:id="@+id/category_segments"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/category_usage_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/layout_category_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="8dp"
                        android:alpha="0.3"
                        android:src="@android:drawable/ic_menu_info_details" />

                    <TextView
                        android:id="@+id/tv_category_empty"
                        style="@style/TextAppearance.DopamineCut.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_category_notice"
                    style="@style/TextAppearance.DopamineCut.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="일부 기록은 분류 중이거나 미확인이에요. 전체 사용량에는 포함돼요."
                    android:visibility="gone" />

                <TextView
                    style="@style/TextAppearance.DopamineCut.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시청 시간·영상 수와 콘텐츠 분석 결과는 다를 수 있어요. 라이브·사진 게시물은 시간만 반영해요." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_detailed_stats"
                    style="@style/Widget.DopamineCut.HomeCompactOutline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="자세한 통계 보기" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_my_change"
            style="@style/Widget.DopamineCut.HomeCompactPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="내 변화 보기 ›" />

        <TextView
            style="@style/TextAppearance.DopamineCut.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="지난 기록과 비교하고 다음 목표를 정해요." />

        <TextView
            android:id="@+id/tv_section_message"
            style="@style/TextAppearance.DopamineCut.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/ui_error"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>